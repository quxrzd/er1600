CXX    = g++
CXXFLG = -std=c++11

SOURCE = $(wildcard src/*.c++)   
OUTPUT = bin/er1600


.DEFAULT_GOAL = all
.PHONY: ini all run cls


ini:
	@echo "working..."
	@mkdir -p bin src
	@rm -f $(OUTPUT)

all:	ini
	@$(CXX) $(CXXFLG) $(SOURCE) -o $(OUTPUT)
	@echo "success."
	@echo ""

run:	all
	@./$(OUTPUT)
	@echo ""

cls:
	@echo "cleaning..."
	@rm -rf bin/
	@echo "success."