C++    = g++
C++FLG = -std=c++11

SRC = $(wildcard src/er1600/*.c++) src/prg.c++
OUT = bin/er1600


## TODO: fix broken makefile.
.DEFAULT_GOAL = all
.PHONY: ini all run clr


ini:
	@echo "working..."
	@mkdir -p bin
	@rm -f $(OUT)

all:	ini
	@$(C++) $(C++FLG) $(SRC) -o $(OUT)
	@echo "success."

run:	all
	@echo ""
	@./$(OUT)
	@echo ""

clr:
	@echo "cleaning..."
	@rm -rf bin/
	@echo "success."
